<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ldr_harambe_v04_description</name>
  <version>0.4.0</version>
  <description>URDF/xacro robot description and meshes for the LD Robots Harambe humanoid (v0.4), generated from Onshape CAD for ROS2 / Gazebo simulation.</description>

  <maintainer email="andrei.dragomir@ldrobots.ro">Andrei Dragomir</maintainer>
  <license>MIT</license>

  <url type="website">https://github.com/LD-Robots/robot-harambe-export</url>
  <url type="repository">https://github.com/LD-Robots/robot-harambe-export</url>

  <author email="andrei.dragomir@ldrobots.ro">Andrei Dragomir</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
